# MinIO server-side only. Keep these out of VITE_* variables.
MINIO_ENDPOINT=
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=
MINIO_PREFIX=birthday/memories/
MEMORIES_API_PORT=8787
TRUST_PROXY=172.17.0.0/16
ALLOWED_ORIGINS=http://localhost:5173
MEMORIES_CACHE_TTL_SECONDS=45
MEMORIES_DB_PATH=./data/birthday-os.sqlite
# Create the password hash with `npm run admin:hash`; never put the password here.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# Public domain stays empty until the site has a production HTTPS URL.
PUBLIC_BASE_URL=
# Frontend-visible API base URL only; contains no credentials.
VITE_MEMORIES_API_BASE_URL=/api
