{
  "name": "birthday-os",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "images:optimize": "node scripts/optimize-images.mjs",
    "api:dev": "node --env-file-if-exists=.env server/index.mjs",
    "api:start": "node server/index.mjs",
    "admin:hash": "node scripts/hash-admin-password.mjs",
    "memories:check": "node --env-file-if-exists=.env scripts/check-memories.mjs",
    "test:api": "node --test server/*.node-test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1167.0",
    "@aws-sdk/s3-request-presigner": "^3.1167.0",
    "@fontsource/nunito": "^5.2.6",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.3",
    "express": "^5.3.0",
    "lucide-react": "^0.468.0",
    "motion": "^12.23.24",
    "multer": "^2.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-photo-album": "^3.6.2",
    "sharp": "^0.35.5",
    "yet-another-react-lightbox": "^3.33.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.1.17",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.19.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@zxing/library": "^0.23.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^27.2.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.1",
    "vite": "^7.2.2",
    "vitest": "^4.0.8"
  }
}
